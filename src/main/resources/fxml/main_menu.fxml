<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lk.icbt.dentalclinic.ui.MainMenuController"
      style="-fx-background-color: #F7F9FC;">
    <padding>
        <Insets top="30" bottom="30" left="30" right="30"/>
    </padding>

    <Label fx:id="welcomeLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1A2B4C;"/>

    <Button text="Register New Appointment" onAction="#goToRegister" prefWidth="240"
            style="-fx-background-color: #4B6FA5; -fx-text-fill: white;"/>
    <Button text="Search Appointment / Generate Bill" onAction="#goToSearch" prefWidth="240"
            style="-fx-background-color: #2F7A5C; -fx-text-fill: white;"/>
    <Button text="Reports" onAction="#goToReports" prefWidth="240"
            style="-fx-background-color: #7A4B96; -fx-text-fill: white;"/>
    <Button text="Help" onAction="#goToHelp" prefWidth="240"
            style="-fx-background-color: #8A6D3B; -fx-text-fill: white;"/>
    <Button text="Exit" onAction="#handleExit" prefWidth="240"
            style="-fx-background-color: #A5544B; -fx-text-fill: white;"/>
</VBox>
