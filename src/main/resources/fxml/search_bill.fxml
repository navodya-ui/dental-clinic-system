<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="lk.icbt.dentalclinic.ui.SearchBillController"
      style="-fx-background-color: #F7F9FC;">
    <padding>
        <Insets top="20" bottom="20" left="24" right="24"/>
    </padding>

    <Label text="Search Appointment &amp; Generate Bill" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #7A4B96;"/>

    <HBox spacing="10">
        <TextField fx:id="appointmentNoField" promptText="Enter Appointment No (e.g. APT0001)" prefWidth="280"/>
        <Button text="Search" onAction="#handleSearch" style="-fx-background-color: #4B6FA5; -fx-text-fill: white;"/>
    </HBox>

    <TextArea fx:id="detailsArea" editable="false" prefHeight="180" wrapText="true"/>

    <HBox spacing="10">
        <Button text="Generate Bill" onAction="#handleGenerateBill" style="-fx-background-color: #7A4B96; -fx-text-fill: white;"/>
        <Button text="Print Receipt" onAction="#handlePrintReceipt" style="-fx-background-color: #2F7A5C; -fx-text-fill: white;"/>
    </HBox>

    <TextArea fx:id="receiptArea" editable="false" prefHeight="140" wrapText="true"/>

    <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #A5544B;"/>

    <Button text="Back to Menu" onAction="#handleBack"/>
</VBox>
